# ============================================================
#  MoneyVerse (OutChase) — environment variables
#  Copy this file to `.env.local` and fill in real values.
#  NEVER commit `.env.local`. This template is safe (no secrets).
#
#  The PUBLIC DEMO (/demo) needs NONE of these — it runs fully
#  client-side on localStorage. These are only required so the
#  rest of the app (auth, payments, DB) also builds & runs.
#
#  Placeholders use <angle-brackets>; replace the whole <...> token.
# ============================================================

# ---------- Clerk (authentication) ----------
# From the Clerk dashboard -> API Keys. Use a PRODUCTION instance for prod.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
CLERK_SECRET_KEY=<your-clerk-secret-key>
# Clerk -> Webhooks -> signing secret (verifies user-sync webhooks)
CLERK_WEBHOOK_SECRET=<your-clerk-webhook-signing-secret>
# Where Clerk hosts the sign-in / sign-up flows
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------- Supabase (database) ----------
# NOT used by the demo. Project -> Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
# Server-only. Full DB access — keep secret, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ---------- Razorpay (payments) ----------
# NOT used by the demo (payments are hidden in /demo). Razorpay dashboard -> API Keys.
RAZORPAY_KEY_ID=<your-razorpay-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-key-secret>
# Public key id used by the client checkout widget
NEXT_PUBLIC_RAZORPAY_KEY_ID=<your-razorpay-key-id>

# ---------- App ----------
# Public base URL of this deployment. Used for OG/canonical links (incl. the demo).
# e.g. https://demo.outchase.in  (or http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
